############################################################
# hri_falcon_robot_bridge — .gitignore
############################################################

# ── Python artifacts ──
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
*.egg
dist/
*.whl

# ── Build / colcon artifacts ──
build/
install/
log/

# ── Generated outputs (models, logs, plots, analysis) ──
# → Google Drive에 별도 백업 (README.md 참조)
outputs/

# ── Log files ──
*.log
nohup.out
MUJOCO_LOG.TXT

# ── Large data / model files ──
*.pt
*.pth
*.onnx
*.h5
*.pkl
*.db
*.bag
*.db3

# ── Dataset images (Conditional Diffusion tutorial 등) ──
scripts/3_model_learning/Conditional Diffusion/datasets/images/

# ── Generated plots / images (논문용은 docs/에 보관) ──
scripts/legacy/plots/

# ── IDE / editor ──
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS ──
.DS_Store
Thumbs.db
